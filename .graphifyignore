# .graphifyignore — keep vendored, generated, and build output out of the knowledge graph.
#
# LOCATION MATTERS: graphify reads .graphifyignore from the SCAN ROOT and its
# ancestors only — see `_load_graphifyignore` (graphify/detect.py:421), called
# from detect() at detect.py:633. A copy under graphify-out/ would never be
# read: it is a *child* of the scan root, and graphify-out/ is itself hard-
# skipped via _SKIP_DIRS (detect.py:359). So this file lives at the repo root.
#
# Syntax is gitignore-style (comments, negation with !, last-match-wins).
# Patterns match the relative path, the basename, and any path segment.
# This mirrors .gitignore + ios/.gitignore wherever the ignored path is
# third-party or machine-generated.

# --- CocoaPods vendored sources (mirrors ios/.gitignore:13 `**/Pods/`) ---
# Firebase / Google / nanopb library source. Zero files tracked in git, but it
# was baking 687 nodes across 142 files into the graph as if it were app code.
ios/Pods/
macos/Pods/

# --- Flutter / Xcode generated + ephemeral platform scaffolding ---
# ephemeral/ mirrors ios/.gitignore:22; .symlinks/ mirrors ios/.gitignore:14 and
# is a symlink farm into the pub cache (16 third-party plugin packages today);
# GeneratedPluginRegistrant mirrors ios/.gitignore:28 + android/.gitignore:7.
ios/Flutter/ephemeral/
ios/.symlinks/
GeneratedPluginRegistrant.*
xcuserdata
DerivedData

# --- Build + tool output ---
# Already covered by graphify's own _SKIP_DIRS / hidden-dir rules (detect.py:352,
# detect.py:664), repeated here so the graph stays clean if those defaults change.
build/
.dart_tool/
coverage/

# --- Golden-test failure output (mirrors .gitignore:54 `test/**/failures/`) ---
# Diff/master/test PNGs regenerated on every failing `flutter test` run. Zero
# files tracked in git; 63 of them were being fed to vision extraction.
test/**/failures/

# --- Generated platform icon + splash density variants ---
# Machine-generated by flutter_launcher_icons (pubspec.yaml:81) and
# flutter_native_splash (pubspec.yaml:80) from the source art in assets/images/.
# 55 rescaled copies of the same logo carry no knowledge the source assets don't.
# assets/images/ itself stays in the graph — that's the real, authored art.
ios/Runner/Assets.xcassets/
android/app/src/main/res/mipmap-*/
android/app/src/main/res/drawable*/

