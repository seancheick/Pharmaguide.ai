{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "google": {
      "apiKey": "{env:GEMINI_API_KEY}",
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash"
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro"
        }
      }
    },
    "groq": {
      "models": {
        "llama-3.3-70b-versatile": {
          "name": "Groq Llama 3.3 70B"
        }
      }
    },
