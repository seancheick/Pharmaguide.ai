# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store
*.xcuserstate
*.xcworkspace/xcuserdata/

# Secrets
.env
.env.*
*.keystore
*.jks

# Catalog rollback backups (created by scripts/import_catalog_artifact.sh).
# These are one-command rollback points, not tracked release artifacts.
assets/db/*.previous

# Generated
*.g.dart
*.freezed.dart
*.mocks.dart
pubspec.lock

# Continue.dev cache
.continue/.cache/
.continue/index/
.continue/sessions/

# Aider
.aider*

# OpenCode
.opencode/
*.DS_Store

# Codex local skills cache
.codex/

# Flutter golden-test failure output — regenerated on every failing run,
# not a tracked artifact. Keep the baseline goldens (test/**/goldens/)
# but never commit the diff/master/test PNGs that land under failures/.
test/**/failures/

sentry.properties
.gstack/

#Graphiphy
graphify-out/

# Test coverage — regenerated on every `flutter test --coverage` run.
# Keep the actual reports out of git; CI can publish them elsewhere.
coverage/

# Playwright MCP capture output — per-session console logs + page yml
# snapshots from the browser MCP. Useful while debugging, never part
# of a release.
.playwright-mcp/

# Ad-hoc QA screenshots from device / browser sessions. Tracked under
# `docs/` when they belong to a doc; the loose JPEGs at the repo root
# are transient.
/qa-*.jpeg
/qa-*.png
/final-cta-live.jpeg