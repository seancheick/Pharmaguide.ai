# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store
*.xcuserstate
*.xcworkspace/xcuserdata/

# Secrets
.env
.env.*
*.keystore
*.jks

# Catalog rollback backups (created by scripts/import_catalog_artifact.sh).
# These are one-command rollback points, not tracked release artifacts.
assets/db/*.previous

# Generated
*.g.dart
*.freezed.dart
*.mocks.dart
pubspec.lock

# Continue.dev cache
.continue/.cache/
.continue/index/
.continue/sessions/

# Aider
.aider*

# OpenCode
.opencode/
*.DS_Store

# Flutter golden-test failure output — regenerated on every failing run,
# not a tracked artifact. Keep the baseline goldens (test/**/goldens/)
# but never commit the diff/master/test PNGs that land under failures/.
test/**/failures/

sentry.properties
.gstack/
